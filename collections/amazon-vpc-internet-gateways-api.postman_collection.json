          "name": "Amazon VPC Create an Internet Gateway",
          "request": {
            "name": "Amazon VPC Create an Internet Gateway",
            "description": {
              "content": "Creates an internet gateway for use with a VPC. After creating the internet gateway, you attach it to a VPC using AttachInternetGateway.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "Action",
                  "value": "CreateInternetGateway"
                }
              ],
              "variable": [
                {
                  "description": "AWS Region",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
          },
