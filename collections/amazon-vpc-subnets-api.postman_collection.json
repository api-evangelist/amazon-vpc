        {
          "id": "adc9f73a-df74-4059-972b-c2c3d30268ec",
          "name": "Amazon VPC Create a Subnet",
          "request": {
            "name": "Amazon VPC Create a Subnet",
            "description": {
              "content": "Creates a subnet in the specified VPC. The new subnet must have a CIDR block that is within the VPC CIDR block. You can optionally specify an Availability Zone in which to create the subnet.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "Action",
                  "value": "CreateSubnet"
                },
                {
                  "disabled": false,
                  "key": "VpcId",
                  "value": "<string>",
                  "description": "(Required) The ID of the VPC"
                },
                {
                  "disabled": false,
                  "key": "CidrBlock",
                  "value": "<string>",
                  "description": "(Required) The IPv4 network range for the subnet in CIDR notation"
                },
                {
                  "disabled": false,
                  "key": "AvailabilityZone",
                  "value": "<string>",
                  "description": "The Availability Zone or Local Zone for the subnet"
                },
                {
                  "disabled": false,
                  "key": "Ipv6CidrBlock",
                  "value": "<string>",
                  "description": "The IPv6 network range for the subnet in CIDR notation"
                }
              ],
              "variable": [
                {
                  "description": "AWS Region",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
