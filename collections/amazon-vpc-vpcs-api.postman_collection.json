          "id": "c7bbad76-bbde-479d-b444-eec25bc2446b",
          "name": "Amazon VPC Create a VPC",
          "request": {
            "name": "Amazon VPC Create a VPC",
            "description": {
              "content": "Creates a VPC with the specified IPv4 CIDR block. The smallest VPC you can create uses a /28 netmask (16 IPv4 addresses), and the largest uses a /16 netmask (65,536 IPv4 addresses). After creating the VPC, you can add one or more subnets.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "Action",
                  "value": "CreateVpc"
                },
                {
                  "disabled": false,
                  "key": "CidrBlock",
                  "value": "<string>",
                  "description": "(Required) The IPv4 network range for the VPC in CIDR notation (e.g., 10.0.0.0/16)"
                },
                {
                  "disabled": false,
                  "key": "AmazonProvidedIpv6CidrBlock",
                  "value": "<boolean>",
                  "description": "Requests an Amazon-provided IPv6 CIDR block with a /56 prefix length"
                },
                {
                  "disabled": false,
                  "key": "InstanceTenancy",
                  "value": "<string>",
                  "description": "The tenancy options for instances launched into the VPC"
                }
              ],
              "variable": [
                {
                  "description": "AWS Region",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
