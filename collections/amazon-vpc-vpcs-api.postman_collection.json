                }
              ],
              "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <vpc>\n    <vpcId>(string)</vpcId>\n    <state>(string)</state>\n    <cidrBlock>(string)</cidrBlock>\n    <cidrBlockAssociationSet>\n      <cidrBlock>(string)</cidrBlock>\n      <associationId>(string)</associationId>\n      <cidrBlockState>\n        <state>(string)</state>\n      </cidrBlockState>\n    </cidrBlockAssociationSet>\n    <cidrBlockAssociationSet>\n      <cidrBlock>(string)</cidrBlock>\n      <associationId>(string)</associationId>\n      <cidrBlockState>\n        <state>(string)</state>\n      </cidrBlockState>\n    </cidrBlockAssociationSet>\n    <ipv6CidrBlockAssociationSet>\n      <ipv6CidrBlock>(string)</ipv6CidrBlock>\n      <associationId>(string)</associationId>\n      <ipv6CidrBlockState>\n        <state>(string)</state>\n      </ipv6CidrBlockState>\n    </ipv6CidrBlockAssociationSet>\n    <ipv6CidrBlockAssociationSet>\n      <ipv6CidrBlock>(string)</ipv6CidrBlock>\n      <associationId>(string)</associationId>\n      <ipv6CidrBlockState>\n        <state>(string)</state>\n      </ipv6CidrBlockState>\n    </ipv6CidrBlockAssociationSet>\n    <dhcpOptionsId>(string)</dhcpOptionsId>\n    <instanceTenancy>(string)</instanceTenancy>\n    <isDefault>(boolean)</isDefault>\n    <ownerId>(string)</ownerId>\n    <tags>\n      <key>(string)</key>\n      <value>(string)</value>\n    </tags>\n    <tags>\n      <key>(string)</key>\n      <value>(string)</value>\n    </tags>\n  </vpc>\n</element>",
