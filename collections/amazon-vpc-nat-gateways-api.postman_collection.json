              "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <natGateway>\n    <natGatewayId>(string)</natGatewayId>\n    <subnetId>(string)</subnetId>\n    <vpcId>(string)</vpcId>\n    <state>(string)</state>\n    <connectivityType>(string)</connectivityType>\n    <natGatewayAddresses>\n      <allocationId>(string)</allocationId>\n      <networkInterfaceId>(string)</networkInterfaceId>\n      <privateIp>(string)</privateIp>\n      <publicIp>(string)</publicIp>\n    </natGatewayAddresses>\n    <natGatewayAddresses>\n      <allocationId>(string)</allocationId>\n      <networkInterfaceId>(string)</networkInterfaceId>\n      <privateIp>(string)</privateIp>\n      <publicIp>(string)</publicIp>\n    </natGatewayAddresses>\n    <createTime>(string)</createTime>\n    <tags>\n      <key>(string)</key>\n      <value>(string)</value>\n    </tags>\n    <tags>\n      <key>(string)</key>\n      <value>(string)</value>\n    </tags>\n  </natGateway>\n</element>",
