              "cookie": [],
              "responseTime": null,
              "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <routeTable>\n    <routeTableId>(string)</routeTableId>\n    <vpcId>(string)</vpcId>\n    <routes>\n      <destinationCidrBlock>(string)</destinationCidrBlock>\n      <destinationIpv6CidrBlock>(string)</destinationIpv6CidrBlock>\n      <gatewayId>(string)</gatewayId>\n      <natGatewayId>(string)</natGatewayId>\n      <networkInterfaceId>(string)</networkInterfaceId>\n      <state>(string)</state>\n      <origin>(string)</origin>\n    </routes>\n    <routes>\n      <destinationCidrBlock>(string)</destinationCidrBlock>\n      <destinationIpv6CidrBlock>(string)</destinationIpv6CidrBlock>\n      <gatewayId>(string)</gatewayId>\n      <natGatewayId>(string)</natGatewayId>\n      <networkInterfaceId>(string)</networkInterfaceId>\n      <state>(string)</state>\n      <origin>(string)</origin>\n    </routes>\n    <associations>\n      <routeTableAssociationId>(string)</routeTableAssociationId>\n      <routeTableId>(string)</routeTableId>\n      <subnetId>(string)</subnetId>\n      <gatewayId>(string)</gatewayId>\n      <main>(boolean)</main>\n    </associations>\n    <associations>\n      <routeTableAssociationId>(string)</routeTableAssociationId>\n      <routeTableId>(string)</routeTableId>\n      <subnetId>(string)</subnetId>\n      <gatewayId>(string)</gatewayId>\n      <main>(boolean)</main>\n    </associations>\n    <ownerId>(string)</ownerId>\n    <tags>\n      <key>(string)</key>\n      <value>(string)</value>\n    </tags>\n    <tags>\n      <key>(string)</key>\n      <value>(string)</value>\n    </tags>\n  </routeTable>\n</element>",
