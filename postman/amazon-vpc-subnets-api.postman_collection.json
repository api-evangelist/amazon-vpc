          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/?Action=CreateSubnet&VpcId=<string>&CidrBlock=<string>&AvailabilityZone=<string>&Ipv6CidrBlock=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ],
              "query": [
                {
                  "key": "Action",
